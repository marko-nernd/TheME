POSTGRES_DB=model_escape
POSTGRES_USER=model_escape
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
APP_PORT=3000
DATABASE_POOL_MAX=10
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
EMAIL_FROM=Model Escape <verify@modelescape.local>

# Stripe test mode. Never commit real secret values.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_PRO_PRICE_ID=
# Customer booking-fee estimate used for event payments. Adjust to your Stripe agreement.
EVENT_PROCESSING_FEE_RATE=0.029
EVENT_PROCESSING_FIXED_FEE_CENTS=30
ID_DOCUMENT_ENCRYPTION_KEY=

# Private Docker heartbeat monitor. Use a long random value outside local development.
MONITOR_SECRET=
MONITOR_INTERVAL_MS=60000
MONITOR_REQUIRED_SAMPLES=3
MONITOR_CPU_THRESHOLD=85
MONITOR_MEMORY_THRESHOLD=85
MONITOR_APP_STORAGE_THRESHOLD_MB=2048
MONITOR_DATABASE_LATENCY_THRESHOLD=1000
MONITOR_RESPONSE_TIME_THRESHOLD=2000
ALERT_EMAIL=admin@modelescape.local

# Set private values before running Compose; never commit the completed .env.
SEED_PASSWORD=
TEST_PASSWORD=
